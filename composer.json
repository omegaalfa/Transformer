{
    "name": "omegaalfa/transformer",
    "description": "Native Tensor & Transformer Runtime for PHP",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11",
        "phpstan/phpstan": "^1",
        "friendsofphp/php-cs-fixer": "^3"
    },
    "autoload": {
        "psr-4": {
            "Omegaalfa\\Transformer\\": "php/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Omegaalfa\\Transformer\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
